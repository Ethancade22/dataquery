{
  "version": "0.1.0",
  "database": "short_video_ops",
  "metrics": [
    {
      "id": "registered_users",
      "name": "注册用户数",
      "description": "按注册时间统计完成注册的用户数。",
      "aliases": ["注册用户", "注册用户数", "新注册用户", "注册人数"],
      "disambiguation_terms": ["注册", "注册时间", "新注册"],
      "metric_field": "user_registrations.user_id",
      "expression": "COUNT(DISTINCT user_registrations.user_id)",
      "aggregation": "count_distinct",
      "entity": "user",
      "time_field": "user_registrations.registered_at",
      "source_tables": ["user_registrations"],
      "dimensions": ["acquisition_channels.channel_name", "user_registrations.platform"],
      "filters": [
        {
          "field": "user_registrations.registration_status",
          "operator": "=",
          "value": "success"
        }
      ],
      "join_paths": [
        {
          "left_table": "acquisition_channels",
          "left_field": "channel_id",
          "right_table": "user_registrations",
          "right_field": "channel_id",
          "relation_type": "foreign_key",
          "description": "注册归因到渠道"
        }
      ],
      "rules": ["registered_users_time_field", "registered_users_status_filter"]
    },
    {
      "id": "activated_users",
      "name": "激活用户数",
      "description": "使用增长日指标表中已聚合的激活用户数。",
      "aliases": ["激活用户数", "新增活跃用户数"],
      "disambiguation_terms": ["激活", "激活用户数", "日指标", "增长指标"],
      "metric_field": "growth_daily_metrics.activated_users",
      "expression": "SUM(growth_daily_metrics.activated_users)",
      "aggregation": "sum",
      "entity": "user",
      "time_field": "growth_daily_metrics.metric_date",
      "source_tables": ["growth_daily_metrics"],
      "dimensions": ["acquisition_channels.channel_name"],
      "filters": [],
      "join_paths": [
        {
          "left_table": "acquisition_channels",
          "left_field": "channel_id",
          "right_table": "growth_daily_metrics",
          "right_field": "channel_id",
          "relation_type": "foreign_key",
          "description": "增长指标按渠道统计"
        }
      ],
      "rules": ["growth_daily_activated_users_time_field"]
    },
    {
      "id": "activation_latency_avg",
      "name": "平均激活耗时",
      "description": "按已激活用户的 activation_seconds 计算平均激活耗时。",
      "aliases": ["平均激活耗时", "激活耗时", "激活时长", "平均激活时长"],
      "disambiguation_terms": ["激活耗时", "平均", "耗时"],
      "metric_field": "user_activations.activation_seconds",
      "expression": "AVG(user_activations.activation_seconds)",
      "aggregation": "avg",
      "entity": "activation",
      "time_field": "user_activations.activated_at",
      "source_tables": ["user_activations"],
      "dimensions": ["acquisition_channels.channel_name"],
      "filters": [
        {
          "field": "user_activations.is_activated",
          "operator": "=",
          "value": 1
        }
      ],
      "join_paths": [
        {
          "left_table": "user_registrations",
          "left_field": "registration_id",
          "right_table": "user_activations",
          "right_field": "registration_id",
          "relation_type": "foreign_key",
          "description": "注册产生激活结果"
        },
        {
          "left_table": "acquisition_channels",
          "left_field": "channel_id",
          "right_table": "user_registrations",
          "right_field": "channel_id",
          "relation_type": "foreign_key",
          "description": "注册归因到渠道"
        }
      ],
      "rules": ["activation_latency_filter"]
    },
