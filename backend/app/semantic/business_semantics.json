  "rules": [
    {
      "id": "registered_users_time_field",
      "label": "注册用户时间口径",
      "issue_type": "wrong_time_field",
      "severity": "error",
      "applies_to_metrics": ["registered_users"],
      "expected": {
        "time_field": "user_registrations.registered_at"
      },
      "message": "注册用户数必须按注册时间 registered_at 过滤。"
    },
    {
      "id": "registered_users_status_filter",
      "label": "注册成功过滤",
      "issue_type": "missing_filter",
      "severity": "warning",
      "applies_to_metrics": ["registered_users"],
      "expected": {
        "filter": "user_registrations.registration_status = 'success'"
      },
      "message": "注册用户数建议限定注册成功状态。"
    },
    {
      "id": "growth_daily_activated_users_time_field",
      "label": "激活用户日指标时间口径",
      "issue_type": "wrong_time_field",
      "severity": "error",
      "applies_to_metrics": ["activated_users"],
      "expected": {
        "time_field": "growth_daily_metrics.metric_date"
      },
      "message": "激活用户数按增长日指标统计时必须使用 metric_date 过滤。"
    },
    {
      "id": "activation_latency_filter",
      "label": "激活耗时有效样本过滤",
      "issue_type": "missing_filter",
      "severity": "warning",
      "applies_to_metrics": ["activation_latency_avg"],
      "expected": {
        "filter": "user_activations.is_activated = 1"
      },
      "message": "平均激活耗时建议限定 is_activated = 1 的已激活样本。"
    },
    {
      "id": "growth_daily_day1_retained_users_time_field",
      "label": "次日留存日指标时间口径",
      "issue_type": "wrong_time_field",
      "severity": "error",
      "applies_to_metrics": ["growth_daily_day1_retained_users"],
      "expected": {
        "time_field": "growth_daily_metrics.metric_date"
      },
      "message": "次日留存用户数按增长日指标统计时必须使用 metric_date 过滤。"
    },
    {
      "id": "growth_daily_day7_retained_users_time_field",
      "label": "七日留存日指标时间口径",
      "issue_type": "wrong_time_field",
      "severity": "error",
      "applies_to_metrics": ["growth_daily_day7_retained_users"],
      "expected": {
        "time_field": "growth_daily_metrics.metric_date"
      },
      "message": "七日留存用户数按增长日指标统计时必须使用 metric_date 过滤。"
    },
    {
      "id": "growth_daily_active_users_time_field",
      "label": "日活用户日指标时间口径",
      "issue_type": "wrong_time_field",
      "severity": "error",
      "applies_to_metrics": ["growth_daily_active_users"],
      "expected": {
        "time_field": "growth_daily_metrics.metric_date"
      },
      "message": "日活用户数按增长日指标统计时必须使用 metric_date 过滤。"
    },
    {
      "id": "growth_daily_new_users_time_field",
      "label": "日指标时间口径",
      "issue_type": "wrong_time_field",
      "severity": "error",
      "applies_to_metrics": ["growth_daily_new_users"],
      "expected": {
        "time_field": "growth_daily_metrics.metric_date"
      },
      "message": "增长日指标必须按 metric_date 过滤。"
    }
  ],
  "ambiguities": [
    {
      "term": "新增用户",
      "parameter": "metric",
      "question": "你说的新增用户是按注册时间、首次活跃/激活时间，还是使用增长日指标表中的已聚合新增用户数？",
      "reason": "新增用户在业务中可能对应多种时间口径，直接选择会影响 SQL 的时间字段和来源表。",
      "candidates": [
        {
          "metric": "registered_users",
          "label": "按注册时间统计新注册用户",
